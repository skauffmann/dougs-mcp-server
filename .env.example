# Dougs credentials (the MCP logs in automatically via POST /auth/api/login)
DOUGS_EMAIL=you@example.com
DOUGS_PASSWORD=your-password

# Optional: pin a company id. If omitted, the user's preferred company is used.
# DOUGS_COMPANY_ID=12345

# Required if the account has MFA: enable the authenticator-app factor in Dougs
# and paste its secret (the `secret=` value of the otpauth:// link, or the whole link).
# DOUGS_TOTP_SECRET=JBSWY3DPEHPK3PXP
